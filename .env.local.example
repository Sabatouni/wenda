# ─────────────────────────────────────────────────────────────
# WENDA — Environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# Supabase project credentials
# Find these in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Optional: Service role key — server-side only, NEVER expose to the browser.
# Required for admin scripts and seeding. Keep out of NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
